    <camera name="bench_cam" pos="1.5 0 1" xyaxes="0 1 -0 -0.534 0 0.8455" fovy="50"/>
    <camera name="end_cam" pos="0.55 3.1 1.2" xyaxes="-1 -0 0 0 -0.0303 0.9995" fovy="70"/>
