    <light name="lamp_a" pos="0.55 -1.4 2.2" dir="0 0.25 -1" cutoff="80" exponent="1" diffuse="0.50 0.50 0.53" castshadow="true"/>
    <light name="lamp_b" pos="0.55 0.4 2.2" dir="0 0 -1" cutoff="80" exponent="1" diffuse="0.55 0.55 0.57" castshadow="true"/>
    <light name="lamp_c" pos="0.55 2.2 2.2" dir="0 -0.2 -1" cutoff="80" exponent="1" diffuse="0.40 0.40 0.44" castshadow="false"/>
